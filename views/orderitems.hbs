<h1>Order Items</h1>

<h2>Browse order items</h2>
<table class="data-table">
    <tr>
        <th>ID</th>
        <th>Order</th>
        <th>Inventory item</th>
        <th>Quantity</th>
        <th>Discount percent</th>
        <th>Selling price</th>
        <th>Shipped</th>
        <th>Shipping date</th>
        <th></th>
    </tr>
    {{#each orderitems}}
    <tr>
        <td>{{this.order_item_id}}</td>
        <td>{{this.order_id}}</td>
        <td>{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</td>
        <td>{{this.quantity}}</td>
        <td>{{this.discount_percent}}</td>
        <td>{{this.selling_price}}</td>
        <td>{{this.shipped}}</td>
        <td>{{formatDate this.shipping_date}}</td>
        <td>
            <form style="display:inline" method="POST" action="/orderitems/delete">
                <input type="hidden" name="order_item_id" value="{{this.order_item_id}}">
                <button type="submit">Delete</button>
        </form>
    </td>
    </tr>
    {{/each}}
</table>

<h2>Create an order item</h2>
<form action="/orderitems/create" method="POST" class="form-card">
    <div class="field">
        <label for="order_id">Order</label>
        <select name="order_id" id="order_id">
            <option value="">Select an order</option>
            {{#each orders}}
            <option value="{{this.order_id}}">#{{this.order_id}} &middot; {{this.customer_first_name}} {{this.customer_last_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="inventory_id">Inventory item</label>
        <select name="inventory_id" id="inventory_id">
            <option value=""></option>
            {{#each inventory}}
            <option value="{{this.inventory_id}}">{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="quantity">Quantity</label>
        <input type="number" name="quantity" id="quantity" min="1">
    </div>

    <div class="field">
        <label for="discount_percent">Discount percent</label>
        <input type="number" name="discount_percent" id="discount_percent" step="0.01" min="0">
    </div>

    <div class="field">
        <label for="selling_price">Selling price</label>
        <input type="number" name="selling_price" id="selling_price" step="0.01" min="0">
    </div>

    <div class="field">
        <label for="shipped">Shipped</label>
        <select name="shipped" id="shipped">
            <option value="">N/A</option>
            <option value="0">No</option>
            <option value="1">Yes</option>
        </select>
    </div>

    <div class="field">
        <label for="shipping_date">Shipping date</label>
        <input type="date" name="shipping_date" id="shipping_date">
    </div>

    <input type="submit" value="Submit">
</form>

<h2>Update an order item</h2>
<form action="/orderitems/update" method="POST" class="form-card">
    <div class="field">
        <label for="update_order_item_id">Order item</label>
        <select name="order_item_id" id="update_order_item_id">
            <option value="">Select an order item</option>
            {{#each orderitems}}
            <option value="{{this.order_item_id}}">#{{this.order_item_id}} &middot; Order {{this.order_id}} &middot; {{this.sku}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_order_id">Order</label>
        <select name="order_id" id="update_order_id">
            <option value="">Select an order</option>
            {{#each orders}}
            <option value="{{this.order_id}}">#{{this.order_id}} &middot; {{this.customer_first_name}} {{this.customer_last_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_inventory_id">Inventory item</label>
        <select name="inventory_id" id="update_inventory_id">
            <option value="">Select an inventory item</option>
            {{#each inventory}}
            <option value="{{this.inventory_id}}">{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_quantity">Quantity</label>
        <input type="number" name="quantity" id="update_quantity" min="1">
    </div>

    <div class="field">
        <label for="update_discount_percent">Discount percent</label>
        <input type="number" name="discount_percent" id="update_discount_percent" step="0.01" min="0">
    </div>

    <div class="field">
        <label for="update_selling_price">Selling price</label>
        <input type="number" name="selling_price" id="update_selling_price" step="0.01" min="0">
    </div>

    <div class="field">
        <label for="update_shipped">Shipped</label>
        <select name="shipped" id="update_shipped">
            <option value="">N/A</option>
            <option value="0">No</option>
            <option value="1">Yes</option>
        </select>
    </div>

    <div class="field">
        <label for="update_shipping_date">Shipping date</label>
        <input type="date" name="shipping_date" id="update_shipping_date">
    </div>

    <input type="submit" value="Submit">
</form>

<script>
    const orderItemRecords = {{{json orderitems}}};

    document.getElementById('update_order_item_id').addEventListener('change', function () {
        const record = orderItemRecords.find(o => String(o.order_item_id) === this.value);

        const fields = [
            'order_id',
            'inventory_id',
            'quantity',
            'discount_percent',
            'selling_price',
            'shipped',
            'shipping_date'
        ];

        fields.forEach(function (field) {
            let value = record ? (record[field] ?? '') : '';

            if (field === 'shipping_date' && value) {
                value = String(value).slice(0, 10);
            }

            document.getElementById('update_' + field).value = value;
        });
    });
</script>
<!DOCTYPE html>
<html>
<head>
    <title>CS340 - Peak Apparel Co.</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="layout">
                <nav class="sidebar">
            <a href="/" class="brand">
                <span class="brand-line">PEAK</span>
                <span class="brand-line">APPAREL</span>
                <span class="brand-rule"></span>
                <span class="brand-sub">Inventory Management</span>
            </a>

            <a href="/" class="nav-link">Home</a>
                <a href="/customers" class="nav-link {{#if (eq page 'customers')}}active{{/if}}">Customers</a>
                <a href="/orders" class="nav-link {{#if (eq page 'orders')}}active{{/if}}">Orders</a>
                <a href="/orderitems" class="nav-link {{#if (eq page 'orderitems')}}active{{/if}}">Order items</a>
                <a href="/inventory" class="nav-link {{#if (eq page 'inventory')}}active{{/if}}">Inventory</a>
                <a href="/distributors" class="nav-link {{#if (eq page 'distributors')}}active{{/if}}">Distributors</a>
                <a href="/purchases" class="nav-link {{#if (eq page 'purchases')}}active{{/if}}">Purchases</a>
                <a href="/purchaseitems" class="nav-link {{#if (eq page 'purchaseitems')}}active{{/if}}">Purchase items</a>

            <form action="/reset" method="POST" class="reset-form">
                <button type="submit" class="btn-reset">Reset data</button>
            </form>
        </nav>

        <main class="content">
            {{{body}}}
        </main>
    </div>
    <script>
    document.querySelectorAll('input[name$="_phone"]').forEach(function (input) {
        input.addEventListener('input', function () {
            const digits = this.value.replace(/\D/g, '').slice(0, 10);
            let formatted = digits;
            if (digits.length > 6) {
                formatted = digits.slice(0, 3) + '-' + digits.slice(3, 6) + '-' + digits.slice(6);
            } else if (digits.length > 3) {
                formatted = digits.slice(0, 3) + '-' + digits.slice(3);
            }
            this.value = formatted;
        });
    });
</script>
</body>
</html>
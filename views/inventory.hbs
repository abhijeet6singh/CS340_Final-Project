<h2>Create an inventory item</h2>
<form>
    <label for="sku">SKU:</label>
    <input type="text" name="sku" id="sku">

    <label for="inventory_type">Inventory type:</label>
    <input type="text" name="inventory_type" id="inventory_type">

    <label for="brand_name">Brand name:</label>
    <input type="text" name="brand_name" id="brand_name">

    <label for="distributor_id">Distributor:</label>
    <select name="distributor_id" id="distributor_id">
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <label for="retail_price">Retail price:</label>
    <input type="number" name="retail_price" id="retail_price" step="0.01" min="0">

    <label for="quantity_in_stock">Quantity in stock:</label>
    <input type="number" name="quantity_in_stock" id="quantity_in_stock" min="0">

    <input type="submit" value="Submit">
</form>

<h2>Update an inventory item</h2>
<form>
    <label for="update_inventory_id">Inventory item to update:</label>
    <select name="inventory_id" id="update_inventory_id">
        <option value="">Select an inventory item</option>
        <option value="101">JKT-204 &middot; Columbia Rain Jacket</option>
        <option value="102">JNS-310 &middot; Levi's Jeans</option>
        <option value="103">HDY-118 &middot; Carhartt Hoodie</option>
        <option value="104">BNE-055 &middot; Patagonia Beanie</option>
    </select>

    <label for="update_sku">SKU:</label>
    <input type="text" name="sku" id="update_sku">

    <label for="update_inventory_type">Inventory type:</label>
    <input type="text" name="inventory_type" id="update_inventory_type">

    <label for="update_brand_name">Brand name:</label>
    <input type="text" name="brand_name" id="update_brand_name">

    <label for="update_distributor_id">Distributor:</label>
    <select name="distributor_id" id="update_distributor_id">
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <label for="update_retail_price">Retail price:</label>
    <input type="number" name="retail_price" id="update_retail_price" step="0.01" min="0">

    <label for="update_quantity_in_stock">Quantity in stock:</label>
    <input type="number" name="quantity_in_stock" id="update_quantity_in_stock" min="0">

    <input type="submit" value="Submit">
</form>
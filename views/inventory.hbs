<header>
    <h1>Inventory</h1>
    <p>Browse, add, update, and delete inventory records.</p>
</header>

<main>
    <section>
        <h2>Browse Existing Inventory</h2>

        <table>
            <thead>
                <tr>
                    <th>inventory_id</th>
                    <th>sku</th>
                    <th>inventory_type</th>
                    <th>brand_name</th>
                    <th>distributor_id</th>
                    <th>Distributor</th>
                    <th>retail_price</th>
                    <th>quantity_in_stock</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>101</td>
                    <td>JKT-204</td>
                    <td>Rain Jacket</td>
                    <td>Columbia</td>
                    <td>1</td>
                    <td>Cascade Apparel Supply</td>
                    <td>89.99</td>
                    <td>12</td>
                </tr>
                <tr>
                    <td>102</td>
                    <td>JNS-310</td>
                    <td>Jeans</td>
                    <td>Levi's</td>
                    <td>2</td>
                    <td>Pacific Garment Wholesale</td>
                    <td>54.99</td>
                    <td>8</td>
                </tr>
                <tr>
                    <td>103</td>
                    <td>HDY-118</td>
                    <td>Hoodie</td>
                    <td>Carhartt</td>
                    <td>1</td>
                    <td>Cascade Apparel Supply</td>
                    <td>42.50</td>
                    <td>20</td>
                </tr>
                <tr>
                    <td>104</td>
                    <td>BNE-055</td>
                    <td>Beanie</td>
                    <td>Patagonia</td>
                    <td>3</td>
                    <td>Northwest Outdoor Apparel</td>
                    <td>34.99</td>
                    <td>15</td>
                </tr>
            </tbody>
        </table>
    </section>
<section>
        <h2>Add New Inventory Item</h2>

        <form>
            <label for="add_sku">SKU</label>
            <input type="text" id="add_sku" name="sku" required>

            <label for="add_inventory_type">Inventory Type</label>
            <input type="text" id="add_inventory_type" name="inventory_type" required>

            <label for="add_brand_name">Brand Name</label>
            <input type="text" id="add_brand_name" name="brand_name" required>

            <label for="add_distributor_id">Distributor</label>
            <select id="add_distributor_id" name="distributor_id" required>
                <option value="">Select a distributor</option>
                <option value="1">1 - Cascade Apparel Supply</option>
                <option value="2">2 - Pacific Garment Wholesale</option>
                <option value="3">3 - Northwest Outdoor Apparel</option>
            </select>

            <label for="add_retail_price">Retail Price</label>
            <input type="number" id="add_retail_price" name="retail_price" step="0.01" min="0" required>

            <label for="add_quantity_in_stock">Quantity in Stock</label>
            <input type="number" id="add_quantity_in_stock" name="quantity_in_stock" min="0" required>

            <button type="submit">Add Inventory Item</button>
        </form>
    </section>

    <section>
        <h2>Update Existing Inventory Item</h2>

        <form>
            <label for="update_inventory_id">Inventory Item</label>
            <select id="update_inventory_id" name="inventory_id" required>
                <option value="">Select an inventory item</option>
                <option value="101">101 - Columbia Rain Jacket</option>
                <option value="102">102 - Levi's Jeans</option>
                <option value="103">103 - Carhartt Hoodie</option>
                <option value="104">104 - Patagonia Beanie</option>
            </select>

            <label for="update_sku">SKU</label>
            <input type="text" id="update_sku" name="sku">

            <label for="update_inventory_type">Inventory Type</label>
            <input type="text" id="update_inventory_type" name="inventory_type">

            <label for="update_brand_name">Brand Name</label>
            <input type="text" id="update_brand_name" name="brand_name">

            <label for="update_distributor_id">Distributor</label>
            <select id="update_distributor_id" name="distributor_id">
                <option value="1">1 - Cascade Apparel Supply</option>
                <option value="2">2 - Pacific Garment Wholesale</option>
                <option value="3">3 - Northwest Outdoor Apparel</option>
            </select>

            <label for="update_retail_price">Retail Price</label>
            <input type="number" id="update_retail_price" name="retail_price" step="0.01" min="0">

            <label for="update_quantity_in_stock">Quantity in Stock</label>
            <input type="number" id="update_quantity_in_stock" name="quantity_in_stock" min="0">

            <button type="submit">Update Inventory Item</button>
        </form>
    </section>

    <section>
        <h2>Delete Inventory Item</h2>

        <form>
            <label for="delete_inventory_id">Inventory Item</label>
            <select id="delete_inventory_id" name="inventory_id" required>
                <option value="">Select an inventory item</option>
                <option value="101">101 - Columbia Rain Jacket</option>
                <option value="102">102 - Levi's Jeans</option>
                <option value="103">103 - Carhartt Hoodie</option>
                <option value="104">104 - Patagonia Beanie</option>
            </select>

            <button type="submit" class="delete-button">Delete Inventory Item</button>
        </form>
    </section>
</main>
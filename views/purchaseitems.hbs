<h1>Purchase Items</h1>

<h2>Browse purchase items</h2>
<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Purchase</th>
        <th>Inventory item</th>
        <th>Quantity purchased</th>
        <th>Price paid</th>
        <th></th>
    </tr>
    {{#each purchaseitems}}
    <tr>
        <td>{{this.purchase_item_id}}</td>
        <td>{{this.purchase_id}}</td>
        <td>{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</td>
        <td>{{this.quantity_purchased}}</td>
        <td>{{this.price_paid}}</td>
        <td>
            <form style="display:inline" method="POST" action="/purchaseitems/delete">
                <input type="hidden" name="purchase_item_id" value="{{this.purchase_item_id}}">
                <button type="submit">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}   
</table>

<h2>Create a purchase item</h2>
<form action="/purchaseitems/create" method="POST">
    <label for="purchase_id">Purchase:</label>
    <select name="purchase_id" id="purchase_id">
        <option value="5001">#5001 &middot; Cascade Apparel Supply &middot; 2026-06-02</option>
        <option value="5002">#5002 &middot; Pacific Garment Wholesale &middot; 2026-06-15</option>
        <option value="5003">#5003 &middot; Northwest Outdoor Apparel &middot; 2026-07-01</option>
    </select>

    <label for="inventory_id">Inventory item:</label>
    <select name="inventory_id" id="inventory_id">
        <option value="101">JKT-204 &middot; Columbia Rain Jacket</option>
        <option value="102">JNS-310 &middot; Levi's Jeans</option>
        <option value="103">HDY-118 &middot; Carhartt Hoodie</option>
        <option value="104">BNE-055 &middot; Patagonia Beanie</option>
    </select>

    <label for="quantity_purchased">Quantity purchased:</label>
    <input type="number" name="quantity_purchased" id="quantity_purchased" min="1">

    <label for="price_paid">Price paid:</label>
    <input type="number" name="price_paid" id="price_paid" step="0.01" min="0">

    <input type="submit" value="Submit">
</form>

<h2>Update a purchase item</h2>
<form action="/purchaseitems/update" method="POST">
    <label for="update_purchase_item_id">Purchase item to update:</label>
    <select name="purchase_item_id" id="update_purchase_item_id">
        <option value="">Select a purchase item</option>
        <option value="9001">#9001 &middot; Purchase 5001 &middot; JKT-204</option>
        <option value="9002">#9002 &middot; Purchase 5001 &middot; HDY-118</option>
        <option value="9003">#9003 &middot; Purchase 5002 &middot; JNS-310</option>
        <option value="9004">#9004 &middot; Purchase 5002 &middot; BNE-055</option>
        <option value="9005">#9005 &middot; Purchase 5003 &middot; JKT-204</option>
    </select>

    <label for="update_inventory_id">Inventory item:</label>
    <select name="inventory_id" id="update_inventory_id">
        <option value="101">JKT-204 &middot; Columbia Rain Jacket</option>
        <option value="102">JNS-310 &middot; Levi's Jeans</option>
        <option value="103">HDY-118 &middot; Carhartt Hoodie</option>
        <option value="104">BNE-055 &middot; Patagonia Beanie</option>
    </select>

    <label for="update_quantity_purchased">Quantity purchased:</label>
    <input type="number" name="quantity_purchased" id="update_quantity_purchased" min="1">

    <label for="update_price_paid">Price paid:</label>
    <input type="number" name="price_paid" id="update_price_paid" step="0.01" min="0">

    <input type="submit" value="Submit">
</form>

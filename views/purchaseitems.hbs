<h1>Purchase Items</h1>

<h2>Browse purchase items</h2>
<table class="data-table">
    <tr>
        <th>ID</th>
        <th>Purchase</th>
        <th>Inventory item</th>
        <th>Quantity purchased</th>
        <th>Price paid</th>
        <th></th>
    </tr>
    {{#each purchaseitems}}
    <tr>
        <td>{{this.purchase_item_id}}</td>
        <td>{{this.purchase_id}}</td>
        <td>{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</td>
        <td>{{this.quantity_purchased}}</td>
        <td>{{this.price_paid}}</td>
        <td>
            <form style="display:inline" method="POST" action="/purchaseitems/delete">
                <input type="hidden" name="purchase_item_id" value="{{this.purchase_item_id}}">
                <button type="submit">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}
</table>

<h2>Create a purchase item</h2>
<form action="/purchaseitems/create" method="POST" class="form-card">
 <div class="field">
        <label for="purchase_id">Purchase</label>
        <select name="purchase_id" id="purchase_id">
            <option value="">Select a purchase</option>
            {{#each purchases}}
            <option value="{{this.purchase_id}}">#{{this.purchase_id}} &middot; {{this.distributor_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="inventory_id">Inventory item</label>
        <select name="inventory_id" id="inventory_id">
            <option value=""></option>
            {{#each inventory}}
            <option value="{{this.inventory_id}}">{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="quantity_purchased">Quantity purchased</label>
        <input type="number" name="quantity_purchased" id="quantity_purchased" min="1">
    </div>

    <div class="field">
        <label for="price_paid">Price paid</label>
        <input type="number" name="price_paid" id="price_paid" step="0.01" min="0">
    </div>

    <input type="submit" value="Submit">
</form>

<h2>Update a purchase item</h2>
<form action="/purchaseitems/update" method="POST" class="form-card">
    <div class="field">
        <label for="update_purchase_item_id">Purchase item to update</label>
        <select name="purchase_item_id" id="update_purchase_item_id">
            <option value="">Select a purchase item</option>
            {{#each purchaseitems}}
            <option value="{{this.purchase_item_id}}">#{{this.purchase_item_id}} &middot; Purchase {{this.purchase_id}} &middot; {{this.sku}}</option>
            {{/each}}
        </select>
    </div>

<div class="field">
        <label for="update_purchase_id">Purchase</label>
        <select name="purchase_id" id="update_purchase_id">
            <option value=""></option>
            {{#each purchases}}
            <option value="{{this.purchase_id}}">#{{this.purchase_id}} &middot; {{this.distributor_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_inventory_id">Inventory item</label>
        <select name="inventory_id" id="update_inventory_id">
            <option value=""></option>
            {{#each inventory}}
            <option value="{{this.inventory_id}}">{{this.sku}} &middot; {{this.brand_name}} {{this.inventory_type}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_quantity_purchased">Quantity purchased</label>
        <input type="number" name="quantity_purchased" id="update_quantity_purchased" min="1">
    </div>

    <div class="field">
        <label for="update_price_paid">Price paid</label>
        <input type="number" name="price_paid" id="update_price_paid" step="0.01" min="0">
    </div>

    <input type="submit" value="Submit">
</form>

<script>
    const purchaseItemRecords = {{{json purchaseitems}}};

    document.getElementById('update_purchase_item_id').addEventListener('change', function () {
        const record = purchaseItemRecords.find(p => String(p.purchase_item_id) === this.value);
        const fields = [
            'purchase_id', 'inventory_id',
            'quantity_purchased', 'price_paid'
        ];
        fields.forEach(function (field) {
            document.getElementById('update_' + field).value = record ? (record[field] ?? '') : '';
        });
    });
</script>
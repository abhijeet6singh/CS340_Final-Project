<h2>Create a distributor</h2>
<form>
    <label for="distributor_name">Distributor name:</label>
    <input type="text" name="distributor_name" id="distributor_name">

    <label for="distributor_street">Street:</label>
    <input type="text" name="distributor_street" id="distributor_street">

    <label for="distributor_city">City:</label>
    <input type="text" name="distributor_city" id="distributor_city">

    <label for="distributor_state">State:</label>
    <input type="text" name="distributor_state" id="distributor_state" maxlength="2">

    <label for="distributor_zip">ZIP:</label>
    <input type="text" name="distributor_zip" id="distributor_zip">

    <label for="distributor_phone">Phone:</label>
    <input type="text" name="distributor_phone" id="distributor_phone">

    <label for="distributor_contact_person">Contact person:</label>
    <input type="text" name="distributor_contact_person" id="distributor_contact_person">

    <input type="submit" value="Submit">
</form>

<h2>Update a distributor</h2>
<form>
    <label for="update_distributor_id">Distributor to update:</label>
    <select name="distributor_id" id="update_distributor_id">
        <option value="">Select a distributor</option>
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <label for="update_distributor_name">Distributor name:</label>
    <input type="text" name="distributor_name" id="update_distributor_name">

    <label for="update_distributor_street">Street:</label>
    <input type="text" name="distributor_street" id="update_distributor_street">

    <label for="update_distributor_city">City:</label>
    <input type="text" name="distributor_city" id="update_distributor_city">

    <label for="update_distributor_state">State:</label>
    <input type="text" name="distributor_state" id="update_distributor_state" maxlength="2">

    <label for="update_distributor_zip">ZIP:</label>
    <input type="text" name="distributor_zip" id="update_distributor_zip">

    <label for="update_distributor_phone">Phone:</label>
    <input type="text" name="distributor_phone" id="update_distributor_phone">

    <label for="update_distributor_contact_person">Contact person:</label>
    <input type="text" name="distributor_contact_person" id="update_distributor_contact_person">

    <input type="submit" value="Submit">
</form>
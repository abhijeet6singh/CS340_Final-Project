<h2>Create a purchase</h2>
<form action="/purchases" method="POST">
    <label for="purchase_date">Purchase date:</label>
    <input type="date" name="purchase_date" id="purchase_date">

    <label for="distributor_id">Distributor:</label>
    <select name="distributor_id" id="distributor_id">
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <input type="submit" value="Submit">
</form>

<h2>Update a purchase</h2>
<form action="/purchases" method="POST">

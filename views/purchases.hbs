<h1>Purchases</h1>

<h2>Browse purchases</h2>
<table class="data-table">
    <tr>
        <th>ID</th>
        <th>Purchase date</th>
        <th>Distributor</th>
        <th></th>
    </tr>
    {{#each purchases}}
    <tr>
        <td>{{this.purchase_id}}</td>
        <td>{{this.purchase_date}}</td>
        <td>{{this.distributor_name}}</td>
        <td>
            <form style="display:inline" method="POST" action="/purchases/delete">
                <input type="hidden" name="purchase_id" value="{{this.purchase_id}}">
                <button type="submit">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}
</table>

<h2>Create a purchase</h2>
<form action="/purchases" method="POST" class="form-card">
    <div class="field">
        <label for="purchase_date">Purchase date</label>
        <input type="date" name="purchase_date" id="purchase_date">
    </div>

    <div class="field">
        <label for="distributor_id">Distributor</label>
        <select name="distributor_id" id="distributor_id">
            {{#each distributors}}
            <option value="{{this.distributor_id}}">{{this.distributor_name}}</option>
            {{/each}}
        </select>
    </div>

    <input type="submit" value="Submit">
</form>

<h2>Update a purchase</h2>
<form action="/purchases" method="POST" class="form-card">
    <div class="field">
        <label for="update_purchase_id">Purchase to update</label>
        <select name="purchase_id" id="update_purchase_id">
            <option value="">Select a purchase</option>
            {{#each purchases}}
            <option value="{{this.purchase_id}}">#{{this.purchase_id}} &middot; {{this.distributor_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="field">
        <label for="update_distributor_id">Distributor</label>
        <select name="distributor_id" id="update_distributor_id">
            {{#each distributors}}
            <option value="{{this.distributor_id}}">{{this.distributor_name}}</option>
            {{/each}}
        </select>
    </div>

    <input type="submit" value="Submit">
</form>

<script>
    const purchaseRecords = {{{json purchases}}};

    document.getElementById('update_purchase_id').addEventListener('change', function () {
        const record = purchaseRecords.find(p => String(p.purchase_id) === this.value);
        document.getElementById('update_distributor_id').value = record ? (record.distributor_id ?? '') : '';
    });
</script>
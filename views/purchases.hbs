<h1>Purchases</h1>

<h2>Browse purchases</h2>
<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Purchase date</th>
        <th>Distributor</th>
        <th></th>
    </tr>
    {{#each purchases}}
    <tr>
        <td>{{this.purchase_id}}</td>
        <td>{{this.purchase_date}}</td>
        <td>{{this.distributor_name}}</td>
        <td>
            <form style="display:inline" method="POST" action="/purchases/delete">
                <input type="hidden" name="purchase_id" value="{{this.purchase_id}}">
                <button type="submit">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}
</table>

<h2>Create a purchase</h2>
<form action="/purchases/create" method="POST">
    <label for="purchase_date">Purchase date:</label>
    <input type="date" name="purchase_date" id="purchase_date">

    <label for="distributor_id">Distributor:</label>
    <select name="distributor_id" id="distributor_id">
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <input type="submit" value="Submit">
</form>

<h2>Update a purchase</h2>
<form action="/purchases/update" method="POST">
    <label for="update_purchase_id">Purchase:</label>
    <select name="purchase_id" id="update_purchase_id">
        <option value="">Select a purchase</option>
        <option value="5001">#5001 &middot; Cascade Apparel Supply &middot; 2026-06-02</option>
        <option value="5002">#5002 &middot; Pacific Garment Wholesale &middot; 2026-06-15</option>
        <option value="5003">#5003 &middot; Northwest Outdoor Apparel &middot; 2026-07-01</option>
    </select>

    <label for="update_purchase_date">Purchase date:</label>
    <input type="date" name="purchase_date" id="update_purchase_date">

    <label for="update_distributor_id">Distributor:</label>
    <select name="distributor_id" id="update_distributor_id">
        <option value="1">Cascade Apparel Supply</option>
        <option value="2">Pacific Garment Wholesale</option>
        <option value="3">Northwest Outdoor Apparel</option>
    </select>

    <input type="submit" value="Submit">
</form>
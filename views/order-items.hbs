            </tbody>
        </table>
    </section>

    <section>
        <h2>Add New Order Item</h2>

        <form>
            <label for="add_order_id">Order</label>
            <select id="add_order_id" name="order_id" required>
                <option value="">Select an order</option>
                <option value="3001">3001 - Maya Torres</option>
                <option value="3002">3002 - Maya Torres</option>
                <option value="3003">3003 - Devon Park</option>
                <option value="3004">3004 - Lena Fischer</option>
            </select>

            <label for="add_inventory_id">Inventory Item</label>
            <select id="add_inventory_id" name="inventory_id" required>
                <option value="">Select inventory item</option>
                <option value="101">101 - Columbia Rain Jacket</option>
                <option value="102">102 - Levi's Jeans</option>
                <option value="103">103 - Carhartt Hoodie</option>
                <option value="104">104 - Patagonia Beanie</option>
            </select>

            <label for="add_quantity">Quantity</label>
            <input type="number" id="add_quantity" name="quantity" min="1" required>

            <label for="add_discount_percent">Discount Percent</label>
            <input type="number" id="add_discount_percent" name="discount_percent" step="0.01" min="0">

            <label for="add_selling_price">Selling Price</label>
            <input type="number" id="add_selling_price" name="selling_price" step="0.01" min="0" required>

            <label for="add_shipped">Shipped</label>
            <select id="add_shipped" name="shipped">
                <option value="">NULL - Not applicable</option>
                <option value="0">0 - Not shipped</option>
                <option value="1">1 - Shipped</option>
            </select>

            <label for="add_shipping_date">Shipping Date</label>
            <input type="date" id="add_shipping_date" name="shipping_date">

            <button type="submit">Add Order Item</button>
        </form>
    </section>

    <section>
        <h2>Update Existing Order Item</h2>

        <form>
            <label for="update_order_item_id">Order Item</label>
            <select id="update_order_item_id" name="order_item_id" required>
                <option value="">Select an order item</option>
                <option value="7001">7001 - Order 3001 - Inventory 101</option>
                <option value="7002">7002 - Order 3001 - Inventory 104</option>
                <option value="7003">7003 - Order 3002 - Inventory 103</option>
                <option value="7004">7004 - Order 3003 - Inventory 102</option>
                <option value="7005">7005 - Order 3004 - Inventory 101</option>
            </select>

            <label for="update_order_id">Order</label>
            <select id="update_order_id" name="order_id">
                <option value="3001">3001 - Maya Torres</option>
                <option value="3002">3002 - Maya Torres</option>
                <option value="3003">3003 - Devon Park</option>
                <option value="3004">3004 - Lena Fischer</option>
            </select>

            <label for="update_inventory_id">Inventory Item</label>
            <select id="update_inventory_id" name="inventory_id">
                <option value="101">101 - Columbia Rain Jacket</option>
                <option value="102">102 - Levi's Jeans</option>
                <option value="103">103 - Carhartt Hoodie</option>
                <option value="104">104 - Patagonia Beanie</option>
            </select>

            <label for="update_quantity">Quantity</label>
            <input type="number" id="update_quantity" name="quantity" min="1">

            <label for="update_discount_percent">Discount Percent</label>
            <input type="number" id="update_discount_percent" name="discount_percent" step="0.01" min="0">

            <label for="update_selling_price">Selling Price</label>
            <input type="number" id="update_selling_price" name="selling_price" step="0.01" min="0">

            <label for="update_shipped">Shipped</label>
            <select id="update_shipped" name="shipped">
                <option value="">NULL - Not applicable</option>
                <option value="0">0 - Not shipped</option>
                <option value="1">1 - Shipped</option>
            </select>

            <label for="update_shipping_date">Shipping Date</label>
            <input type="date" id="update_shipping_date" name="shipping_date">

            <button type="submit">Update Order Item</button>
        </form>
    </section>

    <section>
        <h2>Delete Order Item</h2>

        <form>
            <label for="delete_order_item_id">Order Item</label>
            <select id="delete_order_item_id" name="order_item_id" required>
                <option value="">Select an order item</option>
                <option value="7001">7001 - Order 3001 - Inventory 101</option>
                <option value="7002">7002 - Order 3001 - Inventory 104</option>
                <option value="7003">7003 - Order 3002 - Inventory 103</option>
                <option value="7004">7004 - Order 3003 - Inventory 102</option>
                <option value="7005">7005 - Order 3004 - Inventory 101</option>
            </select>

            <button type="submit" class="delete-button">Delete Order Item</button>
        </form>
    </section>
</main>